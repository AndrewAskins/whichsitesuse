# Copy to .env for local work. On Render, set these in the service's Environment tab.
PORT=3000
PUBLIC_BASE_URL=http://localhost:3000
LOG_LEVEL=info

# App database (Render Postgres "whichsitesuse-db"; use its internal URL on Render).
DATABASE_URL=

# Monthly snapshot on local disk.
SNAPSHOT_DIR=./data/snapshot

# Kill switch: false stops serving every HTTP Archive row.
SERVE_HTTPARCHIVE=true

# BigQuery, WhichSitesUse Google Cloud project only (never MetaMonster's).
GCP_PROJECT_ID=
# The service account key file's full JSON contents, on one line.
GOOGLE_APPLICATION_CREDENTIALS_JSON=
# Hard cap per BigQuery job, in bytes (default 200 GiB).
BIGQUERY_MAX_BYTES_BILLED=

# Pipeline cron job: dry-run, measure, sample, monthly or seo (rebuild the page data only). CRAWL_DATE (YYYY-MM-01) pins a month.
PIPELINE_MODE=dry-run
# report mode: technologies to profile from the published snapshot
REPORT_TECHNOLOGIES=hubspot,salesforce,shopify,stripe
CRAWL_DATE=

# Signing secret for magic links, sessions, CSRF and checkout links. At least 32 random characters.
SESSION_SECRET=

# Stripe (WhichSitesUse's own account, test mode keys until launch).
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Transactional email via Loops. Empty key: emails are written to the log instead.
# Each template id comes from its transactional email in Loops (see README for the templates).
LOOPS_API_KEY=
LOOPS_TEMPLATE_VERIFY=
LOOPS_TEMPLATE_LOGIN=
LOOPS_TEMPLATE_CREDITS_APPROVED=
LOOPS_TEMPLATE_CREDITS_DENIED=
LOOPS_TEMPLATE_ADMIN_ALERT=

# Cloudflare Turnstile on sign-up. Empty: the check is skipped (local work only).
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Admins (comma-separated emails) and where abuse alerts go.
ADMIN_EMAILS=
ADMIN_ALERT_EMAIL=
ALERT_GRANTS_PER_DAY=25

# Monthly pipeline storage. GCS_BUCKET holds BigQuery's raw export for a few hours.
GCS_BUCKET=whichsitesuse-extracts
PIPELINE_WORK_DIR=./data/pipeline
PIPELINE_MEMORY_LIMIT=1200MB
PIPELINE_THREADS=2

# Cloudflare R2 (S3 API) for published snapshots. The query service downloads
# the month that snapshots/current.json points at and rechecks every
# SNAPSHOT_POLL_MINUTES.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=whichsitesuse-snapshots
SNAPSHOT_MEMORY_LIMIT=256MB
SNAPSHOT_POLL_MINUTES=360

# Programmatic pages: a local SEO dataset file. Leave unset on Render (the API reads it from R2).
SEO_DATASET_PATH=
