{
  "name": "whichsitesuse",
  "version": "0.1.0",
  "private": true,
  "description": "Website technology lookup for agents: MCP server and REST API over HTTP Archive data.",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json && node scripts/copy-assets.mjs",
    "start": "node dist/index.js",
    "start:web": "node dist/db/migrate.js && node dist/index.js",
    "dev": "tsx watch src/index.ts",
    "migrate": "tsx src/db/migrate.ts",
    "pipeline": "node dist/pipeline/cli.js",
    "pipeline:dev": "tsx src/pipeline/cli.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "site:sync": "node scripts/sync-site.mjs",
    "site:check": "node scripts/sync-site.mjs --check",
    "seo:export": "tsx src/seo/export.ts",
    "og:static": "tsx src/og/static.ts",
    "site:meta": "tsx src/site/meta.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1172.0",
    "@aws-sdk/lib-storage": "^3.1172.0",
    "@duckdb/node-api": "^2.0.0-r.1",
    "@google-cloud/bigquery": "^9.6.1",
    "@google-cloud/storage": "^9.0.0",
    "@modelcontextprotocol/sdk": "^1.32.2",
    "@resvg/resvg-js": "^2.6.2",
    "express": "^5.3.0",
    "pg": "^8.23.1",
    "pino": "^10.4.0",
    "stripe": "^23.2.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^26.6.6",
    "@types/pg": "^8.23.1",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.1.1"
  }
}
